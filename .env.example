# Use a long random hexadecimal password (URL safe). Never commit .env.
POSTGRES_PASSWORD=replace-with-random-hex-before-start
APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
SCAN_INTERVAL_SECONDS=300

# Optional Microsoft Purview Data Map publishing (disabled until you have an account).
PURVIEW_ENABLED=false
PURVIEW_ENDPOINT=
PURVIEW_COLLECTION_ID=
PURVIEW_NAMESPACE=atlas-local
PURVIEW_AUTH_MODE=default
PURVIEW_CREATE_TYPES=true
PURVIEW_SYNC_AFTER_SCAN=false
# Optional service-principal authentication; prefer managed identity on Azure.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
